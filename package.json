{
  "name": "sistema-avaliacao-projetos-ifms",
  "private": true,
  "version": "0.15.1",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --strictPort --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && node scripts/guardas.mjs && node scripts/guardas-docs.mjs && node scripts/guardas-auditoria.mjs",
    "guardas:docs": "node scripts/guardas-docs.mjs",
    "guardas:auditoria": "node scripts/guardas-auditoria.mjs",
    "contraste": "node scripts/contraste.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:reset": "npx supabase@2.122.0 db reset && node --env-file-if-exists=.env --env-file-if-exists=.env.simulacao.local scripts/criar-contas-locais.mjs",
    "local:semear": "node --env-file-if-exists=.env --env-file-if-exists=.env.simulacao.local scripts/semear-simulacao.mjs",
    "local:simular": "node --env-file-if-exists=.env --env-file-if-exists=.env.simulacao.local scripts/simular-feira.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.77.0",
    "qrcode.react": "4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "minimatch": "^11.0.1"
  }
}
