# Copie para .env (que não é versionado):  cp .env.example .env
# Guia: docs/arquitetura/configuracao.md

# Desenvolvimento usa o Supabase LOCAL (npx supabase start). Nunca aponte o .env para produção.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
# Cole a chave "anon" / "publishable" exibida por: npx supabase@2.122.0 status
VITE_SUPABASE_ANON_KEY=""

# URL da aplicação
APP_URL="http://localhost:3000"
